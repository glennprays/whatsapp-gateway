# -----------------------------------
# Server Configuration
# -----------------------------------
PORT=3000
BASIC_AUTH_SECRET_KEY=secret
ENV=development


# -----------------------------------
# Logging Configuration
# -----------------------------------
LOG_LEVEL=debug
LOG_OUTPUT=stdout
LOG_FILE_PATH=/var/log/whatsapp-gateway.log
LOG_ENABLE_CALLER=true


# -----------------------------------
# HTTP Configuration
# -----------------------------------
BASE_PATH=/api

# -----------------------------------
# Swagger Configuration
# -----------------------------------
ENABLE_DOCUMENTATION=false
DOCUMENTATION_USER=secret
DOCUMENTATION_PASSWORD=secret
DOCUMENTATION_BASE_PATH=/docs

# -----------------------------------
# JWT Configuration
# -----------------------------------
JWT_SECRET=secret
JWT_TOKEN_DURATION_MINUTES=60
JWT_ISSUER=whatsapp-gateway

# -----------------------------------
# Whatsapp Configuration
# -----------------------------------
WHATSAPP_DATASTORE_TYPE=sqlite
WHATSAPP_DATASTORE_URI=file:dbs/whatsapp.db?_pragma=foreign_keys(1)
WHATSAPP_DEVICE_LABEL="Whatsapp Gateway"
WHATSAPP_WEBHOOK_HMAC_ENCRYPTION_MASTER_KEY=0123456789abcdef0123456789abcdef

# -----------------------------------
# RabbitMQ Configuration
# -----------------------------------
RABBITMQ_ENABLED=true
RABBITMQ_URL=amqp://user:user@localhost:5672/
RABBITMQ_CONNECTION_NAME=whatsapp-gateway
RABBITMQ_PREFETCH_COUNT=5

# -----------------------------------
# Worker Pool Sizes
# -----------------------------------
WORKER_INCOMING_EVENTS=5
WORKER_WEBHOOK_DELIVERY=10
WORKER_OUTGOING_MESSAGES=3

# -----------------------------------
# Queue Retry Settings
# -----------------------------------
QUEUE_MAX_RETRIES=3

# -----------------------------------
# Status Webhook Configuration
# -----------------------------------
# Enable webhooks for message status updates (sent/failed)
WEBHOOK_STATUS_EVENTS_ENABLED=true
# Comma-separated list of events to send
# Options: message.queued, message.sent, message.failed
WEBHOOK_STATUS_EVENTS=message.sent,message.failed

# -----------------------------------
# Storage Configuration
# -----------------------------------
# Options: s3, local (both are production-ready)
# - s3: AWS S3, MinIO, DigitalOcean Spaces, etc. - Best for distributed systems and CDN
# - local: Filesystem storage - Simple, full control, good for self-hosted deployments
STORAGE_PROVIDER=local

# S3/S3-Compatible Configuration (for s3 provider)
STORAGE_S3_ENDPOINT=s3.amazonaws.com
STORAGE_S3_ACCESS_KEY_ID=your_access_key
STORAGE_S3_SECRET_ACCESS_KEY=your_secret_key
STORAGE_S3_REGION=us-east-1
STORAGE_S3_BUCKET=whatsapp-gateway
STORAGE_S3_USE_SSL=true
# Presigned URL expiration time in seconds (for s3 provider)
# URLs are valid for this duration, then expire and become invalid
STORAGE_S3_PRESIGNED_URL_EXPIRY_SECONDS=86400  # 1 day

# Local Storage Configuration (for local provider - production-ready)
# Use persistent storage in production: /var/lib/whatsapp-gateway/storage or Docker volume
STORAGE_LOCAL_PATH=./storage

# Base URL for public file access (optional)
# Only needed for local provider if serving files via a web server
# Example: https://example.com/storage
STORAGE_BASE_URL=""

# Storage API Path (optional, default: /storage)
# Path for serving files directly from the gateway
STORAGE_API_PATH=/storage

# -----------------------------------
# Webhook Media Configuration
# -----------------------------------
# Enable automatic download and storage of WhatsApp media in webhooks
WEBHOOK_MEDIA_DOWNLOAD_ENABLED=false

# Storage path prefix for downloaded media files (e.g., webhook/media/phone123/2024/02/uuid.jpg)
WEBHOOK_MEDIA_STORAGE_PREFIX=webhook/media

# Timeout for downloading media from WhatsApp (in seconds)
WEBHOOK_MEDIA_DOWNLOAD_TIMEOUT_SECONDS=30

# Include WhatsApp URL in webhook payload if storage fails
WEBHOOK_MEDIA_FALLBACK_TO_WHATSAPP_URL=true

# Number of days to retain stored media files before auto-deletion
# Set to 0 to disable auto-deletion
WEBHOOK_MEDIA_RETENTION_DAYS=30

# Maximum file size for downloaded media (in bytes)
# Default: 10485760 (10MB)
WEBHOOK_MEDIA_MAX_FILE_SIZE_BYTES=10485760

# -----------------------------------
# Storage Auto-Delete Configuration
# -----------------------------------
# Enable automatic deletion of expired media files
STORAGE_AUTO_DELETE_ENABLED=false

# Interval in hours between auto-delete cleanup jobs
STORAGE_AUTO_DELETE_INTERVAL_HOURS=24
