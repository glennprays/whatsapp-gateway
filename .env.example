# -----------------------------------
# Server Configuration
# -----------------------------------
PORT=3000
BASIC_AUTH_SECRET_KEY=secret
ENV=development


# -----------------------------------
# Logging Configuration
# -----------------------------------
LOG_LEVEL=debug
LOG_OUTPUT=stdout
LOG_FILE_PATH=/var/log/whatsapp-gateway.log
LOG_ENABLE_CALLER=true


# -----------------------------------
# HTTP Configuration
# -----------------------------------
BASE_PATH=/api

# -----------------------------------
# Swagger Configuration
# -----------------------------------
ENABLE_DOCUMENTATION=false
DOCUMENTATION_USER=secret
DOCUMENTATION_PASSWORD=secret
DOCUMENTATION_BASE_PATH=/docs

# -----------------------------------
# JWT Configuration
# -----------------------------------
JWT_SECRET=secret
JWT_TOKEN_DURATION_MINUTES=60
JWT_ISSUER=whatsapp-gateway

# -----------------------------------
# Whatsapp Configuration
# -----------------------------------
# Note: The /dbs directory is pre-created in the container image.
# For persistent data storage, mount a volume to /dbs when running Docker:
#   docker run -v whatsapp-data:/dbs --env-file .env whatsapp-gateway
# Without a volume mount, all data is lost when the container is removed.
#
# SQLite notes:
# - The gateway automatically applies journal_mode(WAL), busy_timeout(5000),
#   and synchronous(NORMAL) pragmas if missing, and clamps the connection
#   pool to a single connection (prevents "database is locked" errors).
#   DB_MAX_OPEN_CONNS / DB_MAX_IDLE_CONNS apply to postgres only.
# - WAL mode creates -wal/-shm sidecar files next to the database, so mount
#   the dbs/ directory (as above), not just the database file.
WHATSAPP_DATASTORE_TYPE=sqlite
WHATSAPP_DATASTORE_URI=file:dbs/whatsapp.db?_pragma=foreign_keys(1)&_pragma=journal_mode(WAL)&_pragma=busy_timeout(5000)&_pragma=synchronous(NORMAL)
WHATSAPP_DEVICE_LABEL="Whatsapp Gateway"
WHATSAPP_WEBHOOK_HMAC_ENCRYPTION_MASTER_KEY=0123456789abcdef0123456789abcdef

# -----------------------------------
# RabbitMQ Configuration
# -----------------------------------
RABBITMQ_ENABLED=true
RABBITMQ_URL=amqp://user:user@localhost:5672/
RABBITMQ_CONNECTION_NAME=whatsapp-gateway
RABBITMQ_PREFETCH_COUNT=5
RABBITMQ_RECONNECT_DELAY_SECONDS=5
# Wait for broker acknowledgement on every publish (prevents silent message loss)
RABBITMQ_PUBLISH_CONFIRM=true
RABBITMQ_CONFIRM_TIMEOUT_SECONDS=5

# -----------------------------------
# Worker Pool Sizes
# -----------------------------------
WORKER_INCOMING_EVENTS=5
WORKER_WEBHOOK_DELIVERY=10
WORKER_OUTGOING_MESSAGES=3

# -----------------------------------
# Queue Retry Settings
# -----------------------------------
QUEUE_MAX_RETRIES=3
# Duplicate detection for redelivered queue messages (in-memory, single instance only)
QUEUE_DEDUP_ENABLED=true
QUEUE_DEDUP_TTL_SECONDS=600

# -----------------------------------
# Rate Limiting
# -----------------------------------
# Per-IP throttle on POST /register (in-process memory limiter; 429 + Retry-After when exceeded).
REGISTER_RATE_LIMIT_ENABLED=true
REGISTER_RATE_LIMIT_REQUESTS=5
REGISTER_RATE_LIMIT_DURATION_SECONDS=60
# Outbound message send pacing (per phone number). Provider: memory | redis | noop.
MESSAGE_RATE_LIMIT_PROVIDER=memory
MESSAGE_RATE_LIMIT_REQUESTS=100
MESSAGE_RATE_LIMIT_DURATION_SECONDS=60

# -----------------------------------
# Upload Limits
# -----------------------------------
# Max outbound media size in bytes, checked before reading into memory (image/audio/video/document/sticker).
MAX_UPLOAD_BYTES=16777216

# -----------------------------------
# Graceful Shutdown
# -----------------------------------
# Overall bound (seconds) for cleanly disconnecting all WhatsApp clients on shutdown,
# before the DB is closed. A hung client is skipped so shutdown never blocks past this.
SHUTDOWN_CLIENT_DISCONNECT_TIMEOUT_SECONDS=10

# -----------------------------------
# Read/Query Surface
# -----------------------------------
# Server-hitting reads (joined groups, profiles, avatars) are short-TTL cached and
# metered per account so polling can't trip WhatsApp anti-spam. A budget token is
# spent only on a cache miss; an exhausted budget returns 429. Local-store reads
# (e.g. GET /contact) are not metered.
READ_QUERY_CACHE_TTL_SECONDS=300
READ_QUERY_BUDGET=30
READ_QUERY_WINDOW_SECONDS=60

# -----------------------------------
# Send Idempotency
# -----------------------------------
# Send endpoints accept an optional `Idempotency-Key` header; duplicates replay
# the original response instead of sending twice (dedup keyed by JWT phone + key,
# DB-backed, survives restarts). TTL = how long a completed response stays
# replayable; PENDING_TIMEOUT = when a row left "pending" by a crashed request
# may be retried. In queue mode this is enqueued-once, not delivered-once.
IDEMPOTENCY_TTL_SECONDS=86400
IDEMPOTENCY_PENDING_TIMEOUT_SECONDS=30

# -----------------------------------
# Status Webhook Configuration
# -----------------------------------
# Enable webhooks for message status updates (sent/failed)
WEBHOOK_STATUS_EVENTS_ENABLED=true
# Comma-separated list of events to send
# Options: message.queued, message.sent, message.failed
WEBHOOK_STATUS_EVENTS=message.sent,message.failed

# -----------------------------------
# Storage Configuration
# -----------------------------------
# Options: s3, local (both are production-ready)
# - s3: AWS S3, MinIO, DigitalOcean Spaces, etc. - Best for distributed systems and CDN
# - local: Filesystem storage - Simple, full control, good for self-hosted deployments
STORAGE_PROVIDER=local

# S3/S3-Compatible Configuration (for s3 provider)
STORAGE_S3_ENDPOINT=s3.amazonaws.com
STORAGE_S3_ACCESS_KEY_ID=your_access_key
STORAGE_S3_SECRET_ACCESS_KEY=your_secret_key
STORAGE_S3_REGION=us-east-1
STORAGE_S3_BUCKET=whatsapp-gateway
STORAGE_S3_USE_SSL=true
# Presigned URL expiration time in seconds (for s3 provider)
# URLs are valid for this duration, then expire and become invalid
STORAGE_S3_PRESIGNED_URL_EXPIRY_SECONDS=86400  # 1 day

# Local Storage Configuration (for local provider - production-ready)
# Use persistent storage in production: /var/lib/whatsapp-gateway/storage or Docker volume
STORAGE_LOCAL_PATH=./storage

# Base URL for public file access (optional)
# Only needed for local provider if serving files via a web server
# Example: https://example.com/storage
STORAGE_BASE_URL=""

# Storage API Path (optional, default: /storage)
# Path for serving files directly from the gateway
STORAGE_API_PATH=/storage

# -----------------------------------
# Webhook Media Configuration
# -----------------------------------
# Enable automatic download and storage of WhatsApp media in webhooks
WEBHOOK_MEDIA_DOWNLOAD_ENABLED=false

# Storage path prefix for downloaded media files (e.g., webhook/media/phone123/2024/02/uuid.jpg)
WEBHOOK_MEDIA_STORAGE_PREFIX=webhook/media

# Timeout for downloading media from WhatsApp (in seconds)
WEBHOOK_MEDIA_DOWNLOAD_TIMEOUT_SECONDS=30

# Include WhatsApp URL in webhook payload if storage fails
WEBHOOK_MEDIA_FALLBACK_TO_WHATSAPP_URL=true

# Number of days to retain stored media files before auto-deletion
# Set to 0 to disable auto-deletion
WEBHOOK_MEDIA_RETENTION_DAYS=30

# Maximum file size for downloaded media (in bytes)
# Default: 10485760 (10MB)
WEBHOOK_MEDIA_MAX_FILE_SIZE_BYTES=10485760

# -----------------------------------
# Storage Auto-Delete Configuration
# -----------------------------------
# Enable automatic deletion of expired media files
STORAGE_AUTO_DELETE_ENABLED=false

# Interval in hours between auto-delete cleanup jobs
STORAGE_AUTO_DELETE_INTERVAL_HOURS=24
